<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.otto.video.mappers.VideoPartitionMapper">

    <resultMap id="videoPartitionMap" type="com.otto.video.entity.po.VideoPartition">
        <id property="partitionId" column="partition_id"/>
        <result property="parentId" column="parent_id"/>
        <result property="name" column="name"/>
        <result property="code" column="code"/>
        <result property="icon" column="icon"/>
        <result property="sort" column="sort"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="base_column">
        partition_id, parent_id, name, code, icon, sort, status, create_time
    </sql>

    <sql id="where_condition">
        <where>
            <if test="query.partitionId != null">and partition_id = #{query.partitionId}</if>
            <if test="query.parentId != null">and parent_id = #{query.parentId}</if>
            <if test="query.name != null and query.name != ''">and name = #{query.name}</if>
            <if test="query.nameFuzzy != null and query.nameFuzzy != ''">and name like concat('%', #{query.nameFuzzy}, '%')</if>
            <if test="query.code != null and query.code != ''">and code = #{query.code}</if>
            <if test="query.status != null">and status = #{query.status}</if>
        </where>
    </sql>

    <select id="selectList" resultMap="videoPartitionMap">
        select <include refid="base_column"/> from video_partition
        <include refid="where_condition"/>
        <if test="query.orderBy != null and query.orderBy != ''">order by ${query.orderBy}</if>
        <if test="query.simplePage != null">limit #{query.simplePage.start}, #{query.simplePage.end}</if>
    </select>

    <select id="selectCount" resultType="java.lang.Integer">
        select count(1) from video_partition
        <include refid="where_condition"/>
    </select>

    <insert id="insert" parameterType="com.otto.video.entity.po.VideoPartition">
        insert into video_partition
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="bean.partitionId != null">partition_id,</if>
            <if test="bean.parentId != null">parent_id,</if>
            <if test="bean.name != null">name,</if>
            <if test="bean.code != null">code,</if>
            <if test="bean.icon != null">icon,</if>
            <if test="bean.sort != null">sort,</if>
            <if test="bean.status != null">status,</if>
            <if test="bean.createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="bean.partitionId != null">#{bean.partitionId},</if>
            <if test="bean.parentId != null">#{bean.parentId},</if>
            <if test="bean.name != null">#{bean.name},</if>
            <if test="bean.code != null">#{bean.code},</if>
            <if test="bean.icon != null">#{bean.icon},</if>
            <if test="bean.sort != null">#{bean.sort},</if>
            <if test="bean.status != null">#{bean.status},</if>
            <if test="bean.createTime != null">#{bean.createTime},</if>
        </trim>
    </insert>

    <insert id="insertOrUpdate" parameterType="com.otto.video.entity.po.VideoPartition">
        insert into video_partition (partition_id, parent_id, name, code, icon, sort, status, create_time)
        values (#{bean.partitionId}, #{bean.parentId}, #{bean.name}, #{bean.code}, #{bean.icon},
                #{bean.sort}, #{bean.status}, coalesce(#{bean.createTime}, now()))
        on duplicate key update
            parent_id = values(parent_id), name = values(name), code = values(code),
            icon = values(icon), sort = values(sort), status = values(status)
    </insert>

    <insert id="insertBatch" parameterType="java.util.List">
        insert into video_partition (parent_id, name, code, icon, sort, status, create_time)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.parentId}, #{item.name}, #{item.code}, #{item.icon}, #{item.sort},
             #{item.status}, coalesce(#{item.createTime}, now()))
        </foreach>
    </insert>

    <insert id="insertOrUpdateBatch" parameterType="java.util.List">
        insert into video_partition (partition_id, parent_id, name, code, icon, sort, status, create_time)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.partitionId}, #{item.parentId}, #{item.name}, #{item.code}, #{item.icon},
             #{item.sort}, #{item.status}, coalesce(#{item.createTime}, now()))
        </foreach>
        on duplicate key update
            parent_id = values(parent_id), name = values(name), code = values(code),
            icon = values(icon), sort = values(sort), status = values(status)
    </insert>

    <update id="updateByParam">
        update video_partition
        <set>
            <if test="bean.parentId != null">parent_id = #{bean.parentId},</if>
            <if test="bean.name != null">name = #{bean.name},</if>
            <if test="bean.code != null">code = #{bean.code},</if>
            <if test="bean.icon != null">icon = #{bean.icon},</if>
            <if test="bean.sort != null">sort = #{bean.sort},</if>
            <if test="bean.status != null">status = #{bean.status},</if>
        </set>
        <include refid="where_condition"/>
    </update>

    <update id="deleteByParam">
        delete from video_partition
        <include refid="where_condition"/>
    </update>

</mapper>
